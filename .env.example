# ============================================
# .env.local  - 로컬 개발용 (local 프로필)
# .env.dev    - 개발 서버용 (dev 프로필)
# ============================================

# ── .env.local에 필요한 값 ──

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Gemini AI
GOOGLE_GENAI_API_KEY=

# INGREDIENT API
INGREDIENT_API_KEY=


# ── .env.dev에 추가로 필요한 값 ──

# Database
DB_HOST=
DB_USERNAME=
DB_PASSWORD=

# Elasticsearch
ELASTICSEARCH_URIS=

# JWT
JWT_SECRET=

# Google OAuth - iOS
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_REDIRECT_URI=

# Google OAuth - Android
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_ANDROID_REDIRECT_URI=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
