# ============================================
# .env.local  - 로컬 개발용 (local 프로필)
# .env.dev    - 개발 서버용 (dev 프로필)
# ============================================

# ── .env.local에 필요한 값 ──

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Gemini AI
GOOGLE_GENAI_API_KEY=

# INGREDIENT API
INGREDIENT_API_KEY=


# ── .env.dev에 추가로 필요한 값 ──

# Database
DB_HOST=
DB_USERNAME=
DB_PASSWORD=

# Elasticsearch
ELASTICSEARCH_URIS=

# JWT
JWT_SECRET=

# Google OAuth - web
GOOGLE_WEB_CLIENT_ID=

# Deep Link (Universal Links / App Links)
DEEP_LINK_WEB_DOMAIN=
DEEP_LINK_IOS_TEAM_ID=
DEEP_LINK_IOS_BUNDLE_ID=
DEEP_LINK_ANDROID_PACKAGE=
DEEP_LINK_ANDROID_SHA256=
DEEP_LINK_APP_STORE_URL=
DEEP_LINK_PLAY_STORE_URL=
